# VetOne API (ask Nordvet IT for real values; never commit them)
VETONE_BASE_URL=https://example-vetone-api.invalid
VETONE_CLIENT_ID=your-client-id
VETONE_CLIENT_SECRET=your-client-secret

# Local warehouse file (gitignored)
DUCKDB_PATH=data/nordvet.duckdb

# First run only: backfill appointments scheduled from this date (YYYY-MM-DD).
# The backfill ends 90 days *ahead* of today to capture future bookings (D-backfill);
# this date alone sets how much history is loaded.
BACKFILL_FROM=2026-09-01
